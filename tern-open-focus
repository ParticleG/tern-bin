#!/bin/sh
# Open files in a new tab of the running Tern, then raise its window.
#
# `tern open` focuses the new block inside Tern but does not activate the
# compositor window, so a Tern window behind others or on another workspace
# stays hidden. Raising is best-effort and only implemented for niri; without
# niri or jq the files still open.
set -eu

tern open --tab "$@"

if [ -n "${NIRI_SOCKET:-}" ] && command -v niri > /dev/null 2>&1 &&
  command -v jq > /dev/null 2>&1; then
  window_id=$(niri msg --json windows 2> /dev/null | jq -r '
    [.[] | select(.app_id == "so.stencil.tern")]
    | max_by([.is_focused, .focus_timestamp.secs, .focus_timestamp.nanos]).id // empty
  ') || window_id=
  if [ -n "$window_id" ]; then
    niri msg action focus-window --id "$window_id" > /dev/null 2>&1 || true
  fi
fi
